<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EfbClient Condition="'$(EfbClient)' == ''">$(MSBuildThisFileDirectory)../../src/EscapeFromBorderlands.Client</EfbClient>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(EfbClient)/ItemDescriptionPatch.cs" Link="Production/ItemDescriptionPatch.cs" />
    <Compile Include="$(EfbClient)/ItemNameColorPatch.cs" Link="Production/ItemNameColorPatch.cs" />
    <Compile Include="$(EfbClient)/LegendaryCatalog.cs" Link="Production/LegendaryCatalog.cs" />
    <Compile Include="$(EfbClient)/RarityResolver.cs" Link="Production/RarityResolver.cs" />
    <Compile Include="$(EfbClient)/MeleeEffectDefinition.cs" Link="Production/MeleeEffectDefinition.cs" />
    <Compile Include="$(EfbClient)/BackpackEffectDefinition.cs" Link="Production/BackpackEffectDefinition.cs" />
    <Compile Include="$(EfbClient)/BackpackBoons.cs" Link="Production/BackpackBoons.cs" />
    <Compile Include="$(EfbClient)/BackpackStorageVariants.cs" Link="Production/BackpackStorageVariants.cs" />
    <EmbeddedResource Include="$(EfbClient)/LegendaryDefinitions.json" LogicalName="Inspection.LegendaryDefinitions.json" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(ReferenceRoot)/Client/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
<ItemGroup><Compile Include="$(EfbClient)/ChestRigEffectDefinition.cs" /><Compile Include="$(EfbClient)/ChestRigBoons.cs" /></ItemGroup><ItemGroup><Compile Include="../../src/EscapeFromBorderlands.Client/GrenadeEffectRules.cs" Link="Client/GrenadeEffectRules.cs" /></ItemGroup><ItemGroup><Compile Include="../../src/EscapeFromBorderlands.Client/EarpieceEffectRules.cs" Link="Production/EarpieceEffectRules.cs" /></ItemGroup><ItemGroup><Compile Include="../../src/EscapeFromBorderlands.Client/EarpieceEffects.cs" Link="Production/EarpieceEffects.cs" /></ItemGroup></Project>
